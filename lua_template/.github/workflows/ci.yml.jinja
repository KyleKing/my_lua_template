{% if include_ci -%}
name: CI

on:
  push:
    branches: [{{ development_branch }}]
  pull_request:
    branches: [{{ development_branch }}]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
{%- if project_type == 'mise-backend' %}

      - name: Install Lua and LuaRocks
        run: |
          sudo apt-get update
          sudo apt-get install -y lua{{ lua_version }} liblua{{ lua_version }}-dev luarocks

      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: .luarocks
          key: luarocks-{% raw %}${{ runner.os }}-${{ hashFiles('mise.toml') }}{% endraw %}
          restore-keys: |
            luarocks-{% raw %}${{ runner.os }}-{% endraw %}
{%- endif %}

      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          experimental: true
          cache: true
{%- if project_type == 'mise-backend' %}

      - name: Install dependencies
        run: mise run install
{%- endif %}

      - name: Run linters
        run: mise run lint

      - name: Run type checker
        run: mise run typecheck
{%- if project_type == 'mise-backend' %}

      - name: Run tests
        run: mise run test
{%- endif %}
{%- if project_type != 'mise-backend' %}

  test-nvim:
    name: Test (Neovim {% raw %}${{ matrix.nvim_version }}{% endraw %}{% if test_os_matrix %}, {% raw %}${{ matrix.os }}{% endraw %}{% endif %})
    needs: lint
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        nvim_version: ["stable", "nightly"]
{%- if test_os_matrix %}
        os: [ubuntu-latest, macos-latest]
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
{%- else %}
    runs-on: ubuntu-latest
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          experimental: true
          cache: true

      - name: Install Neovim
        uses: rhysd/action-setup-vim@febef33995d6649302e9d88dda81e071b68f16a7 # v1.6.1
        with:
          neovim: true
          version: {% raw %}${{ matrix.nvim_version }}{% endraw %}

      - name: Download mini.nvim
        run: mise run deps-mini-nvim

      - name: Run tests
        run: mise run test
{%- endif %}
{%- endif %}
