{% if include_ci -%}
name: CI

on:
  push:
    branches: [{{ development_branch }}]
  pull_request:
    branches: [{{ development_branch }}]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6

{% if project_type == 'mise-backend' -%}
      - name: Install Lua and LuaRocks
        run: |
          sudo apt-get update
          sudo apt-get install -y lua{{ lua_version }} liblua{{ lua_version }}-dev luarocks

      - uses: actions/cache@v5
        with:
          path: .luarocks
          key: luarocks-{% raw %}${{ runner.os }}-${{ hashFiles('mise.toml') }}{% endraw %}
          restore-keys: |
            luarocks-{% raw %}${{ runner.os }}-{% endraw %}
{% endif -%}

      - uses: jdx/mise-action@v3
        with:
          experimental: true
          cache: true

{% if project_type == 'mise-backend' -%}
      - name: Install dependencies
        run: mise run install
{% endif -%}

      - name: Run linters
        run: mise run lint

      - name: Run type checker
        run: mise run typecheck

      - name: Run tests
        run: mise run test

{% if project_type != 'mise-backend' -%}
  test-nvim:
    name: Test (Neovim {% raw %}${{ matrix.nvim_version }}{% endraw %})
    needs: lint
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        nvim_version: ["stable", "nightly"]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6

      - uses: jdx/mise-action@v3
        with:
          experimental: true
          cache: true

      - name: Install Neovim
        uses: rhysd/action-setup-vim@v1
        with:
          neovim: true
          version: {% raw %}${{ matrix.nvim_version }}{% endraw %}

      - name: Download mini.nvim
        run: mise run deps-mini-nvim

      - name: Run tests
        run: mise run test
{% endif -%}
{% endif -%}
