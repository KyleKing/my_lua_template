[tools]
hk = "1.53.0"
{% if project_type == 'mise-backend' -%}
lua = "{{ lua_version }}"
{% endif -%}
pkl = "latest"
stylua = "2.5.2"
"cargo:selene" = "0.31.0"
{% if use_cz -%}
"pipx:commitizen" = "latest"
{% endif -%}
"pipx:toml-sort" = "latest"
{% if project_type == 'mise-backend' -%}

[tasks.install]
description = "Install dependencies with luarocks"
run = "luarocks install --tree=.luarocks --only-deps ."

[tasks.test]
description = "Run all tests with busted"
run = "busted"

[tasks.test-file]
description = "Run a specific test file"
run = "busted {% raw %}{{flag(name='file')}}{% endraw %}"
usage = '''
flag "-f --file"
'''
{% else -%}

[tasks."deps-mini-nvim"]
description = "Download 'mini.nvim' to use its 'mini.test' testing module"
run = '''
DIRECTORY="deps/mini.nvim"
if [ ! -d "$DIRECTORY" ]; then
    mkdir -p "$DIRECTORY"
    git clone --filter=blob:none https://github.com/echasnovski/mini.nvim "$DIRECTORY"
fi
'''
sources = ["deps/mini.nvim"]

# Note on the -c bodies below: headless Neovim does not exit after a failed -c
# command, so every Lua entry point is wrapped in pcall with an explicit
# `cquit 1`. Without the guard, an error hangs the process until the CI timeout.
[tasks.test]
depends = ["deps-mini-nvim"]
description = "Run all test files"
{% if project_type == 'nvim-config' -%}
run = "nvim --headless --noplugin -u ./init.lua -c \"lua local ok, err = pcall(function() require('tests.init').run_all() end) if not ok then io.stderr:write(tostring(err) .. '\\n') vim.cmd('cquit 1') end\""
{% else -%}
run = "nvim --headless --noplugin -u ./scripts/minimal_init.lua -c \"lua local ok, err = pcall(function() require('{{ plugin_slug }}.tests.init').run_all() end) if not ok then io.stderr:write(tostring(err) .. '\\n') vim.cmd('cquit 1') end\""
{% endif %}

[tasks.test-file]
depends = ["deps-mini-nvim"]
description = "Run test from specified file"
run = "nvim --headless --noplugin -u ./scripts/minimal_init.lua -c \"lua local ok, err = pcall(MiniTest.run_file, vim.fn.fnamemodify('{% raw %}{{flag(name='file')}}{% endraw %}', ':p')) if not ok then io.stderr:write(tostring(err) .. '\\n') vim.cmd('cquit 1') end\""
usage = '''
flag "-f --file"
'''
{% endif %}

[tasks.lint]
description = "Format code using stylua (check mode)"
{% if project_type == 'mise-backend' -%}
run = "stylua hooks/ spec/ --check"
{% elif project_type == 'nvim-config' -%}
run = "stylua lua/ --check"
{% else -%}
run = "stylua plugin/ lua/ --check"
{% endif %}

[tasks.format]
description = "Format code using stylua (fix mode)"
{% if project_type == 'mise-backend' -%}
run = "stylua hooks/ spec/"
{% elif project_type == 'nvim-config' -%}
run = "stylua lua/"
{% else -%}
run = "stylua plugin/ lua/"
{% endif %}

[tasks.typecheck]
description = "Check for errors with selene"
{% if project_type == 'mise-backend' -%}
run = "selene hooks/ spec/"
{% elif project_type == 'nvim-config' -%}
run = "selene lua/"
{% else -%}
run = "selene plugin/ lua/"
{% endif %}

[tasks.ci]
description = "Run all CI checks"
depends = ["lint", "typecheck", "test"]
