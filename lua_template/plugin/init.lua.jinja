{% if project_type == 'nvim-plugin' -%}
-- {{ project_name }} plugin entry point
-- This file is automatically loaded by neovim

if vim.g.loaded_{{ plugin_slug | replace('-', '_') }} then return end
vim.g.loaded_{{ plugin_slug | replace('-', '_') }} = 1

-- Load the plugin module
require("{{ plugin_slug }}")
{% endif -%}
